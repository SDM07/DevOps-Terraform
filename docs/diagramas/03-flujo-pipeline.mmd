flowchart LR
  subgraph PRFLOW["1 · Pull Request (terraform-ci) — nada se aplica"]
    direction TB
    A["Rama feature/*"] --> B["Pull Request a main"]
    B --> C{"Validación estática<br/>fmt · validate · tflint<br/>terraform test · Checkov · Gitleaks"}
    C -- ok --> D["Plan dev + plan prod<br/>rol SOLO LECTURA (OIDC)<br/>publicado en el PR"]
    D --> G{"Guardia del plan<br/>¿destroy/replace en prod?"}
    G -- ok --> E["Revisión CODEOWNERS<br/>+ checks obligatorios"]
  end

  C -- falla --> X["❌ Merge bloqueado"]
  G -- "sí, sin etiqueta allow-destroy" --> X

  E --> F["Merge a main (squash)"]

  subgraph CDFLOW["2 · Despliegue (terraform-cd) — mismo commit, dev → prod"]
    direction TB
    H["Plan + apply dev<br/>env dev"] --> I["Smoke test dev<br/>services-stable + /health"]
    I --> J["Plan prod<br/>resumen al aprobador"]
    J --> K{"🔒 Aprobación manual<br/>environment prod"}
    K -- aprueba --> L["Apply prod<br/>plan exacto aprobado"]
    L --> M["Smoke test prod<br/>rollback ECS si falla"]
  end

  F --> H
  K -- rechaza --> Y["⏹ No se despliega a prod"]
  M --> N["✅ Desplegado"]
